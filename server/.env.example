DATABASE_URL="postgresql://postgres:postgres@localhost:5432/icemixers?schema=public"
JWT_SECRET="change-me-to-a-random-string-of-32+-chars"
CLIENT_ORIGIN="http://localhost:5173"
PORT=4000
NODE_ENV=development
# Optional: card payments are NOT implemented; leave empty
STRIPE_SECRET_KEY=
# Business config
TAX_RATE_BPS=1800
DELIVERY_FEE_MINOR=2900
FREE_DELIVERY_THRESHOLD_MINOR=39900
ENABLE_COD=true
# Sample (unverified) prices are visible/purchasable only when allowed (default: allowed in dev, blocked in production)
# ALLOW_SAMPLE_PRICES=true
# Postal PIN lookup (India Post public API) and optional reverse geocoding
# PINCODE_API_URL=https://api.postalpincode.in/pincode
# REVERSE_GEOCODE_URL=https://nominatim.openstreetmap.org/reverse
# GEOCODER_USER_AGENT="IceCocktailMixersExpress/1.0 (contact: you@example.com)"
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
