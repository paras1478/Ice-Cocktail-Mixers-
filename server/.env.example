# PostgreSQL connection string (placeholder: put the real value only in your git-ignored server/.env, or in Render > Environment).
# Local example: postgresql://<user>:<password>@localhost:5432/icemixers?schema=public
# Production (Render): paste the "Internal Database URL" of your Render PostgreSQL. Production refuses to start with a localhost or non-postgresql URL.
DATABASE_URL="postgresql://<user>:<password>@<host>:5432/<database>?schema=public"
JWT_SECRET="change-me-to-a-random-string-of-32+-chars"
CLIENT_ORIGIN="http://localhost:5173"
PORT=4000
NODE_ENV=development
# Optional: card payments are NOT implemented; leave empty
STRIPE_SECRET_KEY=
# Razorpay online payments (UPI / cards). Backend only. Use TEST keys (rzp_test_...) until test mode is verified.
# Live keys (rzp_live_...) are refused unless RAZORPAY_ALLOW_LIVE=true. Never put these in a VITE_ variable or commit real values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you choose in Razorpay Dashboard > Webhooks (event: payment.captured, order.paid, payment.failed); the same value goes here.
RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_ALLOW_LIVE=false
# Business config
TAX_RATE_BPS=1800
DELIVERY_FEE_MINOR=2900
FREE_DELIVERY_THRESHOLD_MINOR=39900
ENABLE_COD=true
# Sample (unverified) prices are visible/purchasable only when allowed (default: allowed in dev, blocked in production)
# ALLOW_SAMPLE_PRICES=true
# Postal PIN lookup (India Post public API), reverse geocoding and address search
# PINCODE_API_URL=https://api.postalpincode.in/pincode
# Geoapify API key for reverse geocoding (pin -> address) and delivery address / PIN search (https://myprojects.geoapify.com). Backend only.
# Use a different key from the browser one in client/.env, so this one never reaches the frontend.
GEOAPIFY_API_KEY=
SEED_ADMIN_EMAIL=you@yourdomain.com
SEED_ADMIN_PASSWORD=<choose-a-strong-password>

# --- Deployment (Render + Vercel) ---
# CLIENT_ORIGIN accepts several origins separated by commas. No trailing slash is needed (one is tolerated).
#   CLIENT_ORIGIN="https://ice-cocktail-beta.vercel.app"
# Vercel preview deployments (new URL every deploy): allow only YOUR project's pattern. One "*" in the first host label, https only.
#   CLIENT_ORIGIN_PATTERNS="https://ice-cocktail-*-pankaj-kumars-projects-d26ce2ff.vercel.app"
# Frontend on a different site than the API (vercel.app + onrender.com) and calling it directly: COOKIE_SAMESITE=none
# (HTTPS only). Not needed when the frontend reaches the API through the /api rewrite in client/vercel.json.
# COOKIE_SAMESITE=lax
# Defaults to true in production (needed behind Render's proxy for per-IP rate limits).
# TRUST_PROXY=true
# The seeded catalogue uses sample (unverified) prices, which are HIDDEN in production unless this is true.
# ALLOW_SAMPLE_PRICES=true

# Google sign-in (public OAuth client IDs, from console.cloud.google.com > APIs & Services > Credentials). Leave unset to hide the buttons.
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com           # Web client (website; also used as the mobile app's web client)
# GOOGLE_ANDROID_CLIENT_ID=xxxx.apps.googleusercontent.com   # Android client (package com.icemixers.express + your SHA-1)
# GOOGLE_IOS_CLIENT_ID=xxxx.apps.googleusercontent.com

# AI voice shopping assistant (OpenAI Realtime API over WebRTC). Backend only: never put this in a VITE_ variable or commit a real value.
# Leave OPENAI_API_KEY empty to hide the voice assistant. The browser only ever receives a short-lived client secret.
OPENAI_API_KEY=
# OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_REALTIME_VOICE=marin
