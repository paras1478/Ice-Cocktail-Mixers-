DATABASE_URL="postgresql://postgres:postgres@localhost:5432/icemixers?schema=public"
JWT_SECRET="change-me-to-a-random-string-of-32+-chars"
CLIENT_ORIGIN="http://localhost:5173"
PORT=4000
NODE_ENV=development
# Optional: card payments are NOT implemented; leave empty
STRIPE_SECRET_KEY=
# Business config
TAX_RATE_BPS=1800
DELIVERY_FEE_MINOR=2900
FREE_DELIVERY_THRESHOLD_MINOR=39900
ENABLE_COD=true
# Sample (unverified) prices are visible/purchasable only when allowed (default: allowed in dev, blocked in production)
# ALLOW_SAMPLE_PRICES=true
# Postal PIN lookup (India Post public API) and optional reverse geocoding
# PINCODE_API_URL=https://api.postalpincode.in/pincode
# REVERSE_GEOCODE_URL=https://nominatim.openstreetmap.org/reverse
# GEOCODER_USER_AGENT="IceCocktailMixersExpress/1.0 (contact: you@example.com)"
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# --- Deployment (Render + Vercel) ---
# CLIENT_ORIGIN accepts several origins separated by commas. No trailing slash is needed (one is tolerated).
#   CLIENT_ORIGIN="https://ice-cocktail-beta.vercel.app"
# Frontend on a different site than the API (vercel.app + onrender.com) and calling it directly: COOKIE_SAMESITE=none
# (HTTPS only). Not needed when the frontend reaches the API through the /api rewrite in client/vercel.json.
# COOKIE_SAMESITE=lax
# Defaults to true in production (needed behind Render's proxy for per-IP rate limits).
# TRUST_PROXY=true
# The seeded catalogue uses sample (unverified) prices, which are HIDDEN in production unless this is true.
# ALLOW_SAMPLE_PRICES=true

# --- User accounts in MongoDB Atlas (optional) ---
# When set, sign-up/sign-in credentials (email + bcrypt hash) are stored in MongoDB; orders, carts and addresses stay in PostgreSQL.
# Backend only: never put this in a VITE_ variable or commit the real value. Set the real value in Render > Environment.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/"
MONGODB_DB=icemixers
