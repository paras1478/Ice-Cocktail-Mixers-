# Public build-time settings only. Everything prefixed VITE_ is bundled into the browser: NEVER put secrets here.

# Backend API URL. Leave empty/unset to use the same-origin "/api" (local dev proxy, or the rewrite in vercel.json).
# To call the backend directly set its address (the "/api" suffix is added automatically if you leave it out):
#   VITE_API_URL=https://ice-cocktail-mixers.onrender.com
# Direct calls are cross-site: the backend then needs CLIENT_ORIGIN and COOKIE_SAMESITE=none (see the README).
VITE_API_URL=
